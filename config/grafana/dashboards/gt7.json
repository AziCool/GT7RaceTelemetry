          "format": "table",
          "query": "base = from(bucket: \"telemetry\") |> range(start: -10m) |> filter(fn: (r) => r[\"_measurement\"] == \"gt7\") |> filter(fn: (r) => r[\"_field\"] == \"pos_X\" or r[\"_field\"] == \"pos_Z\" or r[\"_field\"] == \"current_lap_raw\" or r[\"_field\"] == \"current_lap_ms\") |> aggregateWindow(every: 1s, fn: last, createEmpty: false) |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> filter(fn: (r) => exists r.pos_X and exists r.pos_Z and exists r.current_lap_raw and exists r.current_lap_ms)\r\nlapTimes = base |> group(columns: [\"current_lap_raw\"]) |> max(column: \"current_lap_ms\") |> group() |> sort(columns: [\"current_lap_ms\"]) |> limit(n: 1)\r\nbestLap = lapTimes |> findRecord(fn: (key) => true, idx: 0)\r\nbase |> filter(fn: (r) => r.current_lap_raw == bestLap.current_lap_raw) |> map(fn: (r) => ({r with best_trace_X: r.pos_X + 5.0, best_trace_Z: r.pos_Z})) |> keep(columns: [\"_time\", \"best_trace_X\", \"best_trace_Z\"])"
